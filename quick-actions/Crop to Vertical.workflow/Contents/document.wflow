				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Crop to Vertical: center-crops each selected image to a 9:16 portrait frame and
# writes &lt;name&gt;-vertical.&lt;ext&gt; next to the original. Originals are never modified.
# Uses sips, which ships with macOS, so there is nothing to install.
for f in "$@"; do
  w=$(sips -g pixelWidth  "$f" 2&gt;/dev/null | awk '/pixelWidth:/  {print $2}')
  h=$(sips -g pixelHeight "$f" 2&gt;/dev/null | awk '/pixelHeight:/ {print $2}')
  [[ "$w" == &lt;-&gt; &amp;&amp; "$h" == &lt;-&gt; ]] || continue
  # Wider than 9:16 -&gt; keep the height and trim the sides. Otherwise keep the
  # width and trim top and bottom. An image already at 9:16 passes through as-is.
  if (( w * 16 &gt; h * 9 )); then
    cw=$(( h * 9 / 16 )); ch=$h
  else
    cw=$w; ch=$(( w * 16 / 9 ))
  fi
  dir="${f:h}"; base="${f:t}"; ext=""
  if [[ "$base" == *.* ]]; then ext=".${base##*.}"; base="${base%.*}"; fi
  sips --cropToHeightWidth "$ch" "$cw" "$f" --out "$dir/${base}-vertical${ext}" &gt;/dev/null
done</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
					<key>source</key>
					<string></string>
				</dict>
