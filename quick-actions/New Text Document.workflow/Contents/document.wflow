				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
	-- Right-clicking empty space passes the open folder; right-clicking an
	-- item passes that item. Folders get the file inside, files beside them.
	tell application "Finder"
		if (count of input) &gt; 0 then
			set clicked to item ((item 1 of input) as text)
			if class of clicked is in {folder, disk} then
				set destFolder to clicked as alias
			else
				set destFolder to (container of clicked) as alias
			end if
		else if (count of windows) &gt; 0 then
			set destFolder to (target of front window) as alias
		else
			set destFolder to (path to desktop folder)
		end if
		set destPath to POSIX path of destFolder
	end tell
	
	set newFilePath to destPath &amp; "New Text Document.txt"
	set i to 2
	tell application "System Events"
		repeat while (exists disk item newFilePath)
			set newFilePath to destPath &amp; "New Text Document (" &amp; i &amp; ").txt"
			set i to i + 1
		end repeat
	end tell
	
	do shell script "touch " &amp; quoted form of newFilePath
	
	tell application "Finder"
		activate
		select (POSIX file newFilePath as alias)
	end tell
	return input
end run</string>
